generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  isPublic      Boolean   @default(false)
  isPremium     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  // Profile fields
  showName      Boolean   @default(true)
  username      String?   @unique
  bio           String?
  avatarUrl     String?
  coverImageUrl String?
  websiteUrl    String?
  twitterHandle String?
  instagramHandle String?
  youtubeUrl    String?
  accounts      Account[]
  sessions      Session[]
  recipes       Recipe[]
  recipeBookMembers RecipeBookMember[] @relation("BookMember")
  invitedMembers    RecipeBookMember[] @relation("BookInvitedBy")
  recipeBookEntries RecipeBookEntry[]
}

model Recipe {
  id            String       @id @default(cuid())
  title         String
  description   String?
  coverImageUrl String?
  authorId      String?
  isPublic     Boolean      @default(false)
  forkedFromId String?
  forkCount    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  author       User?        @relation(fields: [authorId], references: [id])
  forkedFrom   Recipe?      @relation("RecipeForks", fields: [forkedFromId], references: [id])
  forks        Recipe[]     @relation("RecipeForks")
  ingredients  Ingredient[]
  steps        Step[]
  recipeBookEntries RecipeBookEntry[]
}

enum RecipeBookRole {
  Owner
  Collaborator
}

model RecipeBook {
  id            String            @id @default(cuid())
  title         String
  description   String?
  coverImageUrl String?
  isPublic      Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  members       RecipeBookMember[]
  entries       RecipeBookEntry[]
}

model RecipeBookMember {
  id             String          @id @default(cuid())
  recipeBookId   String
  userId         String
  role           RecipeBookRole
  acceptedAt     DateTime?
  invitedByUserId String
  createdAt      DateTime        @default(now())
  recipeBook     RecipeBook      @relation(fields: [recipeBookId], references: [id], onDelete: Cascade)
  user           User            @relation("BookMember", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy      User            @relation("BookInvitedBy", fields: [invitedByUserId], references: [id])

  @@unique([recipeBookId, userId])
}

model RecipeBookEntry {
  id             String     @id @default(cuid())
  recipeBookId   String
  recipeId       String
  addedByUserId  String
  orderIndex     Int
  createdAt      DateTime   @default(now())
  recipeBook     RecipeBook @relation(fields: [recipeBookId], references: [id], onDelete: Cascade)
  recipe         Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  addedBy        User       @relation(fields: [addedByUserId], references: [id])

  @@unique([recipeBookId, recipeId])
}

model Ingredient {
  id         String  @id @default(cuid())
  recipeId   String
  name       String
  quantity   String?
  unit       String?
  orderIndex Int
  recipe     Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Step {
  id           String  @id @default(cuid())
  recipeId     String
  instruction  String
  imageUrl     String?
  timerSeconds Int?
  orderIndex   Int
  recipe       Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}
